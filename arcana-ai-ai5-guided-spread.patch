+  flex-wrap: wrap;
+  align-items: center;
+  gap: 15px;
+  margin-top: 22px;
+}
+
+.guided-spread-details-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  color: #cbb8ce;
+  font-family: var(--heading-font);
