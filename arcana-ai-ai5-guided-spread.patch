+.guided-recommendation-preview svg:nth-child(1) { left: 0; transform: rotate(-9deg); }
+.guided-recommendation-preview svg:nth-child(2) { left: 40px; top: 9px; transform: rotate(-4deg); }
+.guided-recommendation-preview svg:nth-child(3) { left: 80px; top: 3px; }
+.guided-recommendation-preview svg:nth-child(4) { left: 120px; top: 9px; transform: rotate(4deg); }
+.guided-recommendation-preview svg:nth-child(5) { left: 160px; transform: rotate(9deg); }
+
+@media (max-width: 720px) {
+  .new-reading-choice-grid,
+  .guided-recommendation-card {
+    grid-template-columns: 1fr;
+  }
+
+  .new-reading-choice-card {
