diff --git a/components/readings/CreateReadingForm.tsx b/components/readings/CreateReadingForm.tsx
new file mode 100644
index 0000000..1c1a012
--- /dev/null
+++ b/components/readings/CreateReadingForm.tsx
@@ -0,0 +1,115 @@
+"use client";
+
+import { useRouter } from "next/navigation";
+import { useState, type ChangeEvent, type FormEvent } from "react";
+import { SparkleIcon, TarotCardBack } from "@/components/icons/ArcanaIcons";
+import { createReading } from "@/lib/api";
+import type { SpreadDetail } from "@/lib/types";
+
+type CreateReadingFormProps = {
+  spread: SpreadDetail;
+};
+
+const MAX_CONTEXT_LENGTH = 500;
+
+export function CreateReadingForm({ spread }: CreateReadingFormProps) {
+  const router = useRouter();
+  const [userContext, setUserContext] = useState("");
+  const [isSubmitting, setIsSubmitting] = useState(false);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+
+  async function handleSubmit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    setErrorMessage(null);
+    setIsSubmitting(true);
+
+    try {
+      const reading = await createReading({
+        spreadKey: spread.key,
+        userContext: userContext.trim() || null,
+      });
+
+      router.push(`/readings/${reading.id}`);
+    } catch (error) {
+      setErrorMessage(
+        error instanceof Error
+          ? error.message
+          : "The reading could not be created.",
+      );
+      setIsSubmitting(false);
+    }
+  }
+
+  return (
+    <form className="spread-detail-form" onSubmit={handleSubmit}>
+      <div className="spread-detail-columns">
+        <section className="spread-positions-section" aria-labelledby="positions-title">
+          <h2 id="positions-title">Positions</h2>
+
+          <div className="position-list">
+            {spread.positions.map((position) => (
+              <article key={position.key} className="position-row">
+                <span className="position-number">{position.order}</span>
+                <div>
+                  <h3>{position.title}</h3>
+                  <p>{position.description}</p>
+                </div>
+              </article>
+            ))}
+          </div>
+        </section>
+
+        <div className="spread-question-column">
+          <div className="spread-card-preview-panel" aria-hidden="true">
+            <div className="spread-detail-card-row">
+              {Array.from({ length: Math.min(spread.cardCount, 5) }).map(
+                (_, index) => (
+                  <div key={index} className="spread-detail-card-item">
+                    <TarotCardBack />
+                    <span>{index + 1}</span>
+                  </div>
+                ),
+              )}
+            </div>
+          </div>
+
+          <section className="question-panel">
+            <h2>Your question (optional)</h2>
+            <p>Add your question or context to focus your reading.</p>
+
+            <label htmlFor="user-context" className="sr-only">
+              Your question or context
+            </label>
+            <textarea
+              id="user-context"
+              value={userContext}
+              maxLength={MAX_CONTEXT_LENGTH}
+              placeholder="What would you like guidance on?"
+              onChange={(event: ChangeEvent<HTMLTextAreaElement>) =>
+                setUserContext(event.target.value)
+              }
+              disabled={isSubmitting}
+            />
+
+            <span className="context-counter">
+              {userContext.length} / {MAX_CONTEXT_LENGTH}
+            </span>
+          </section>
+        </div>
+      </div>
+
+      {errorMessage ? (
+        <p className="form-error" role="alert">
+          {errorMessage}
+        </p>
+      ) : null}
+
+      <button type="submit" className="create-reading-button" disabled={isSubmitting}>
+        <span>{isSubmitting ? "Creating reading..." : "Create reading"}</span>
+        <SparkleIcon />
+      </button>
+
+      <p className="create-reading-note">We will draw the cards for you.</p>
+    </form>
+  );
+}
diff --git a/components/readings/ReadingHistory.tsx b/components/readings/ReadingHistory.tsx
new file mode 100644
index 0000000..51f7a2c
--- /dev/null
+++ b/components/readings/ReadingHistory.tsx
@@ -0,0 +1,198 @@
+"use client";
+
+import Link from "next/link";
+import { useMemo, useState, type ChangeEvent } from "react";
+import {
+  ChevronDownIcon,
+  ChevronRightIcon,
+  SearchIcon,
+  TarotCardBack,
+} from "@/components/icons/ArcanaIcons";
+import type { PagedReadingsResponse, ReadingSummary } from "@/lib/types";
+
+type ReadingHistoryProps = {
+  result: PagedReadingsResponse;
+};
+
+type SortOrder = "newest" | "oldest";
+
+function formatReadingDate(value: string): { date: string; time: string } {
+  const date = new Date(value);
+
+  return {
+    date: new Intl.DateTimeFormat("en-US", {
+      month: "short",
+      day: "numeric",
+      year: "numeric",
+    }).format(date),
+    time: new Intl.DateTimeFormat("en-US", {
+      hour: "numeric",
+      minute: "2-digit",
+    }).format(date),
+  };
+}
+
+function getReadingTitle(reading: ReadingSummary): string {
+  return reading.userContext?.trim() || `${reading.spreadName} reading`;
+}
+
+export function ReadingHistory({ result }: ReadingHistoryProps) {
+  const [query, setQuery] = useState("");
+  const [spreadKey, setSpreadKey] = useState("all");
+  const [sortOrder, setSortOrder] = useState<SortOrder>("newest");
+
+  const spreadOptions = useMemo(() => {
+    const unique = new Map<string, string>();
+    result.items.forEach((reading) => unique.set(reading.spreadKey, reading.spreadName));
+    return [...unique.entries()];
+  }, [result.items]);
+
+  const visibleReadings = useMemo(() => {
+    const normalizedQuery = query.trim().toLowerCase();
+
+    const filtered = result.items.filter((reading) => {
+      const title = getReadingTitle(reading).toLowerCase();
+      const matchesQuery =
+        !normalizedQuery ||
+        title.includes(normalizedQuery) ||
+        reading.spreadName.toLowerCase().includes(normalizedQuery);
+      const matchesSpread = spreadKey === "all" || reading.spreadKey === spreadKey;
+      return matchesQuery && matchesSpread;
+    });
+
+    return [...filtered].sort((first, second) => {
+      const firstDate = new Date(first.createdAtUtc).getTime();
+      const secondDate = new Date(second.createdAtUtc).getTime();
+      return sortOrder === "newest" ? secondDate - firstDate : firstDate - secondDate;
+    });
+  }, [query, result.items, sortOrder, spreadKey]);
+
+  return (
+    <>
+      <div className="history-toolbar">
+        <label className="history-search">
+          <span className="sr-only">Search your readings</span>
+          <SearchIcon />
+          <input
+            type="search"
+            placeholder="Search your readings..."
+            value={query}
+            onChange={(event: ChangeEvent<HTMLInputElement>) =>
+              setQuery(event.target.value)
+            }
+          />
+        </label>
+
+        <label className="history-select">
+          <span className="sr-only">Filter by spread</span>
+          <select value={spreadKey} onChange={(event: ChangeEvent<HTMLSelectElement>) =>
+            setSpreadKey(event.target.value)
+          }>
+            <option value="all">All Spreads</option>
+            {spreadOptions.map(([key, name]) => (
+              <option key={key} value={key}>
+                {name}
+              </option>
+            ))}
+          </select>
+          <ChevronDownIcon />
+        </label>
+
+        <label className="history-select">
+          <span className="sr-only">Sort readings</span>
+          <select
+            value={sortOrder}
+            onChange={(event: ChangeEvent<HTMLSelectElement>) =>
+              setSortOrder(event.target.value as SortOrder)
+            }
+          >
+            <option value="newest">Newest First</option>
+            <option value="oldest">Oldest First</option>
+          </select>
+          <ChevronDownIcon />
+        </label>
+      </div>
+
+      {visibleReadings.length === 0 ? (
+        <div className="history-empty">
+          <h2>No readings found</h2>
+          <p>Create a new reading or adjust your search filters.</p>
+          <Link href="/spreads">Begin a reading</Link>
+        </div>
+      ) : (
+        <div className="reading-history-list">
+          {visibleReadings.map((reading) => {
+            const formatted = formatReadingDate(reading.createdAtUtc);
+
+            return (
+              <Link key={reading.id} href={`/readings/${reading.id}`} className="reading-history-row">
+                <TarotCardBack />
+
+                <div className="reading-history-copy">
+                  <h2>{getReadingTitle(reading)}</h2>
+                  <p>{reading.spreadName}</p>
+                </div>
+
+                <time dateTime={reading.createdAtUtc} className="reading-history-date">
+                  <span>{formatted.date}</span>
+                  <span>{formatted.time}</span>
+                </time>
+
+                <span className="reading-card-count">
+                  {reading.cardCount} {reading.cardCount === 1 ? "card" : "cards"}
+                </span>
+
+                <ChevronRightIcon className="reading-history-chevron" />
+              </Link>
+            );
+          })}
+        </div>
+      )}
+
+      {result.totalPages > 1 ? (
+        <nav className="pagination" aria-label="Reading history pages">
+          <Link
+            href={`/readings?page=${Math.max(1, result.page - 1)}`}
+            aria-disabled={result.page <= 1}
+            className={result.page <= 1 ? "is-disabled" : ""}
+          >
+            ‹
+          </Link>
+
+          {Array.from({ length: result.totalPages }, (_, index) => index + 1)
+            .filter(
+              (page) =>
+                page === 1 ||
+                page === result.totalPages ||
+                Math.abs(page - result.page) <= 1,
+            )
+            .map((page, index, pages) => {
+              const previous = pages[index - 1];
+              const needsEllipsis = previous !== undefined && page - previous > 1;
+
+              return (
+                <span key={page} className="pagination-fragment">
+                  {needsEllipsis ? <span className="pagination-ellipsis">…</span> : null}
+                  <Link
+                    href={`/readings?page=${page}`}
+                    className={page === result.page ? "is-current" : ""}
+                    aria-current={page === result.page ? "page" : undefined}
+                  >
+                    {page}
+                  </Link>
+                </span>
+              );
+            })}
+
+          <Link
+            href={`/readings?page=${Math.min(result.totalPages, result.page + 1)}`}
+            aria-disabled={result.page >= result.totalPages}
+            className={result.page >= result.totalPages ? "is-disabled" : ""}
+          >
+            ›
+          </Link>
+        </nav>
+      ) : null}
+    </>
+  );
+}
