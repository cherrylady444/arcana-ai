FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 API_INTERNAL_BASE_URL=http://127.0.0.1:5000
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 API_INTERNAL_BASE_URL=http://127.0.0.1:5000
COPY --from=build --chown=node:node /app/ ./
USER node
CMD ["npm","run","start","--","--hostname","127.0.0.1","--port","3000"]
