{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5000",
  "AiService": {
    "BaseUrl": "http://127.0.0.1:8000/",
    "TimeoutSeconds": 160
  },
  "Security": {
    "Authority": "http://localhost:8081/realms/arcana",
    "PublicOrigin": "http://localhost:3000",
    "ClientId": "arcana-web",
    "IdleMinutes": 30,
    "AbsoluteHours": 8,
    "RevalidationSeconds": 60,
    "DataProtectionKeyPath": ".security-keys"
  }
}
