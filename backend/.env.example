# IMPORTANT FOR YOUR EXISTING DATABASE VOLUME:
# POSTGRES_PASSWORD must initially match the password that was used when the
# current PostgreSQL volume was created. In your current Compose setup that
# password is arcana_password. Changing this variable alone does not change
# the password stored inside an already initialized PostgreSQL database.

POSTGRES_DB=arcana_ai
POSTGRES_USER=arcana_user
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5432

API_HOST_PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# Use the same pgAdmin login you already use with the existing pgAdmin volume.
PGADMIN_DEFAULT_EMAIL=example@gmail.com
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_HOST_PORT=5050
