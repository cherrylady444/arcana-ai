OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=3000


KNOWLEDGE_DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
RAG_CONVERSATION_TOP_K=4

# SEC3: confidential client arcana-ai (not arcana-web).
AI_AUTH_ISSUER=http://localhost:8081/realms/arcana
AI_INTROSPECTION_SECRET=
